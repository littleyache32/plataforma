{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "devCommand": "vite --port $PORT",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [{ "path": "/api/cron/mentor", "schedule": "0 9 * * *" }],
  "rewrites": [
    { "source": "/api/plano", "destination": "/api/sessoes?recurso=plano" },
    { "source": "/api/estudo", "destination": "/api/catalogo?recurso=estudo" },
    { "source": "/api/admin/acervo", "destination": "/api/admin/seed?recurso=acervo" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 300
    }
  }
}
