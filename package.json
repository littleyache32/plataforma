{
  "name": "mentor-de-estudos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "vercel dev",
    "build": "vite build --configLoader runner",
    "preview": "vite preview",
    "test": "vitest run --configLoader runner",
    "lint": "node scripts/lint.js",
    "migrate": "node --env-file=.env.local scripts/migrate.js",
    "import:bacen": "node --env-file=.env.local scripts/import-curated-bacen.js",
    "acervo:gerar": "node --env-file=.env.local scripts/build-complete-library.js --generate",
    "acervo:expandir:faculdade": "node --env-file=.env.local scripts/build-complete-library.js --generate --context=faculdade --target-questions=30 --target-cards=50",
    "acervo:expandir:bacen": "node --env-file=.env.local scripts/build-complete-library.js --generate --context=concurso --target-questions=30 --target-cards=50",
    "acervo:importar": "node --env-file=.env.local scripts/build-complete-library.js --apply",
    "acervo:producao": "node --env-file=.env.local scripts/generate-production-library.js",
    "acervo:reconstruir": "node --env-file=.env.local scripts/rebuild-production-library.js",
    "acervo:expandir:300-600": "node --env-file=.env.local scripts/expand-requested-batch.js --questions=300 --cards=600",
    "acervo:expandir:offline": "node --env-file=.env.local scripts/expand-offline-library.js",
    "acervo:expandir:offline:aplicar": "node --env-file=.env.local scripts/expand-offline-library.js --apply",
    "acervo:normalizar:exato": "node --env-file=.env.local scripts/normalize-exact-library.js",
    "acervo:normalizar:exato:aplicar": "node --env-file=.env.local scripts/normalize-exact-library.js --apply",
    "template:exportar": "node scripts/build-empty-platform-package.js",
    "audit:producao": "node --env-file=.env.local scripts/audit-production.js",
    "audit:cobertura": "node --env-file=.env.local scripts/audit-coverage.js",
    "audit:questoes": "node --env-file=.env.local scripts/audit-and-adapt-library.js",
    "audit:expansao": "node --env-file=.env.local scripts/audit-question-expansion.js",
    "audit:cards": "node --env-file=.env.local scripts/audit-and-adapt-cards.js",
    "audit:secrets": "node scripts/audit-git-secrets.js",
    "mentor:simular": "node scripts/simulate-mentor-trajectory.js",
    "estrategia:auditar": "node --env-file=.env.local scripts/import-strategy-library.js",
    "estrategia:importar": "node --env-file=.env.local scripts/import-strategy-library.js --apply",
    "estrategia:questoes:inicial": "node --env-file=.env.local scripts/import-strategy-library.js --apply --questions-only --target-questions=50",
    "estrategia:questoes:completar": "node --env-file=.env.local scripts/fill-bacen-question-gaps.js --apply",
    "estrategia:cards": "node --env-file=.env.local scripts/import-strategy-library.js --apply --cards-only",
    "estrategia:validar": "node --env-file=.env.local scripts/audit-strategy-production.js"
  },
  "dependencies": {
    "@google/genai": "^1.28.0",
    "@napi-rs/canvas": "^0.1.80",
    "@supabase/supabase-js": "^2.57.4",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  }
}
